html
    head
        meta(charset='utf-8')
        title #{title}
        block styles
            link(rel="stylesheet" href="/bootstrap/css/bootstrap.css")
            link(rel="stylesheet" href="/css/style.css")
            link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css")
            link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css")
    body
        nav(class="navbar navbar-light" style="background-color: #B0DDFB;")
            div(class="container-md")
                a(href="/listStudentGroups" class="navbar-brand") Студенческие группы
                a(href="/listStudents" class="navbar-brand") Студенты
                a(href="/listTeachers" class="navbar-brand") Преподаватели
                a(href="/listDisciplines" class="navbar-brand") Учебные дисциплины
                a(href="/listDisciplineTeacher" class="navbar-brand") Учебные дисциплины преподавателей
                a(href="/schedule" class="navbar-brand") Расписание занятий
                a(href="/attendanceJournal" class="navbar-brand") Журнал посещаемости
        div(class="container-md mt-3")
            block content
        block scripts
            script(src="/js/jquery-3.7.1.min.js")
            script(src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js")
            script(src="https://cdn.jsdelivr.net/npm/moment@2.29.4/min/moment-with-locales.min.js")
            script(src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js")
            script(src="/js/script.js")
            script(src="/bootstrap/js/bootstrap.js")
            script(src="/js/ckeditor/ckeditor.js")