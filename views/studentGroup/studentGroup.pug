extends ../head
block content
    if studentGroup != null
        form(action="/updateStudentGroup/" + studentGroup.id, method="POST")
            input(name="name" type="text" placeholder="Наименование группы" value=studentGroup.name required)
            input(type="submit" value="Обновить")
        form(action="/deleteStudentGroup/" + studentGroup.id, method="POST")
            input(type="submit" value="Удалить")
    else 
        p Группа с таким id не найдена