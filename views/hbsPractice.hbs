<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{title}}</title>
</head>
<body>

<h1>{{title}}</h1>
<p>Сейчас {{a}} год</p>

{{#if try}}
    <p>text</p>
{{else}}
    <p>:IBGOWDJVN:LSDJONV:JSDv</p>
{{/if}}

{{#each arr}}
    <p>{{this}}</p>
{{/each}}

{{#if b1}}
    <p>1</p>
{{else if b2}}
    <p>2</p>
{{else if b3}}
    <p>3</p>
{{else}}
    <p>null</p>
{{/if}}

</body>
</html>