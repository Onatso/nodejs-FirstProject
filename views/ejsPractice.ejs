<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Работа с шаблонизатором EJS</title>
</head>
<body>

<% var a = 2026 %>
<% var b = Math.floor(Math.random() * 10) + 1 %>

<h1>Работа с шаблонизатором EJS</h1>
<p>Сейчас <%= a %> год</p>

<% if (b >= 5) { %>
    <p>text</p>
<% } else { %>
    <p>:IBGOWDJVN:LSDJONV:JSDv</p>
<% } %>

<% for (var i = 1; i <= 5; i++) { %>
    <p><%= i %></p>
<% } %>

<% switch (b) { 
    case 1: %>
        <p>1</p>
    <% break;
    case 2: %>
        <p>2</p>
    <% break;
    case 3: %>
        <p>3</p>
    <% break;
    default: %>
        <p>null</p>
<% } %>

</body>
</html>