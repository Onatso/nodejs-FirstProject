extends ../head
block content
    a(href="/addDisciplineTeacher" class="btn btn-success") Добавить новую запись
    table(class="table table-bordered table-striped mt-3")
        thead(class="table-primary")
            tr
                th №
                th Дисциплина
                th Преподаватель
                th Действие
        tbody
            - var i = 1;
            each el in disciplineTeacher
                tr
                    td #{i}
                    td #{el.discipline_name}
                    td #{el.teacher_name}
                    td
                        div(class="col-md-5")
                            form(action="/deleteDisciplineTeacher/disciplineId=" + el.discipline_id + "/teacherId=" + el.teacher_id, method="POST")
                                div(class="form-group mb-3")
                                    input(type="submit" value="Удалить" class="btn btn-danger")
                - i++