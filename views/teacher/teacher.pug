extends ../head
block content
    if teacher != null
        form(action="/updateTeacher/" + teacher.id, method="POST")
            input(name="name" type="text" placeholder="ФИО преподавателя" value=teacher.name required)
            input(type="submit" value="Обновить")
        form(action="/deleteTeacher/" + teacher.id, method="POST")
            input(type="submit" value="Удалить")
    else
        p Преподаватель с таким id не найден